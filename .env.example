DATABASE_URL=sqlite:///./data/fastlane.db
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Server-side API address, including an internal container URL when deployed.
API_BASE_URL=http://127.0.0.1:8000
DATA_CACHE_DIR=./data/raw
APP_ENV=development
REFRESH_INTERVAL_SECONDS=300
# Docker production: set a strong URL-safe password; never commit the real value.
# POSTGRES_PASSWORD=...
# BACKUP_DIR=./data/backups
# Optional: pin the evaluated report to use after qualifying.
# MODEL_REPORT_PATH=./ml/artifacts/YOUR_RUN/report.json
